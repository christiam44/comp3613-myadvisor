				{
					"name": "Login student",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"const body = pm.response.json();\r",
									"pm.test(\"Returns a bearer token\", () => {\r",
									"    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;\r",
									"    pm.expect(body.token_type).to.eql(\"bearer\");\r",
									"});\r",
									"\r",
									"pm.collectionVariables.set(\"student_token\", body.access_token);"
