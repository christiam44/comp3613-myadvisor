								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{api_base}}/records/{{course_code_1}}",
							"host": [
								"{{api_base}}"
							],
							"path": [
								"records",
								"{{course_code_1}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get progress after completion",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"   pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"   const p = pm.response.json();\r",
									"   const code = pm.collectionVariables.get(\"course_code_1\");\r",
									"   const rec = p.records.find(r => r.course_code === code);\r",
									"\r",
									"   pm.test(\"Course is listed as completed with grade A\", () => {\r",
									"       pm.expect(rec).to.not.be.undefined;\r",
									"       pm.expect(rec.status).to.eql(\"completed\");\r",
									"       pm.expect(rec.grade).to.eql(\"A\");\r",
									"   });\r",
									"   pm.test(\"Completed credits include the course\", () => {\r",
									"       pm.expect(p.completed_credits).to.be.at.least(rec.credits);\r",
									"       pm.expect(p.completed_credits).to.be.at.least(Number(pm.collectionVariables.get(\"credits_before\")));\r",
									"   });\r",
									"   pm.test(\"At least one course is counted as completed\", () => {\r",
									"       pm.expect(p.completed_count).to.be.at.least(1);\r",
									"   });"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{api_base}}/progress",
							"host": [
