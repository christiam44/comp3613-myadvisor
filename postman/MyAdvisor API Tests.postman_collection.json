		{
			"name": "4 - Student Progress",
			"item": [
				{
					"name": "Get progress",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"const p = pm.response.json();\r",
									"pm.test(\"Summary has the expected fields\", () => {\r",
									"    pm.expect(p).to.have.property(\"completed_credits\");\r",
									"    pm.expect(p).to.have.property(\"completed_count\");\r",
									"    pm.expect(p).to.have.property(\"in_progress_count\");\r",
									"    pm.expect(p.required_credits).to.eql(93);\r",
									"    pm.expect(p.records).to.be.an(\"array\");\r",
									"});\r",
									"pm.test(\"Each record has code, credits and status\", () => {\r",
									"    p.records.forEach(r => {\r",
									"        pm.expect(r).to.have.property(\"course_code\");\r",
									"        pm.expect(r).to.have.property(\"credits\");\r",
									"        pm.expect(r).to.have.property(\"status\");\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.collectionVariables.set(\"credits_before\", p.completed_credits);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{api_base}}/progress",
							"host": [
								"{{api_base}}"
							],
