		{
			"name": "2 - Student Plan",
			"item": [
				{
					"name": "Get courses",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"   pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"   const courses = pm.response.json();\r",
									"   pm.test(\"Returns a non-empty list of courses\", () => {\r",
									"       pm.expect(courses).to.be.an(\"array\").that.is.not.empty;\r",
									"   });\r",
									"   pm.test(\"Each course has code, title and credits\", () => {\r",
									"       courses.forEach(c => {\r",
									"           pm.expect(c).to.have.property(\"course_code\");\r",
									"           pm.expect(c).to.have.property(\"title\");\r",
									"           pm.expect(c).to.have.property(\"credits\");\r",
									"       });\r",
									"   });\r",
									"\r",
									"   pm.collectionVariables.set(\"course_code_1\", courses[0].course_code);\r",
									"   pm.collectionVariables.set(\"course_code_2\", courses[1].course_code);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
