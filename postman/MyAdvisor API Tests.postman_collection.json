									"  pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"  const rec = pm.response.json();\r",
									"  pm.test(\"Record is completed with the grade\", () => {\r",
									"      pm.expect(rec.course_code).to.eql(pm.collectionVariables.get(\"course_code_1\"));\r",
									"      pm.expect(rec.status).to.eql(\"completed\");\r",
									"      pm.expect(rec.grade).to.eql(\"A\");\r",
									"  });"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "PUT",
