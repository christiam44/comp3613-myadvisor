@startuml
!pragma layout smetana
skinparam shadowing false
skinparam actorBorderColor #1B365D
skinparam actorFontColor #1E232D
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #1B365D
skinparam usecaseFontColor #1E232D
skinparam rectangleBorderColor #1B365D
skinparam rectangleBackgroundColor #F8FAFC
skinparam arrowColor #1B365D

actor "Student" as Student

rectangle "MyAdvisor" {
  usecase "Plan Semester Courses" as Plan_Semester_Courses
  usecase "View Degree Progress" as View_Degree_Progress
  usecase "Track Degree Progress" as Track_Degree_Progress
  usecase "Approve Semester Plan" as Approve_Semester_Plan
}

actor "Advisor" as Advisor

Student --> Plan_Semester_Courses
Plan_Semester_Courses ..> View_Degree_Progress : <<include>>
Student --> Track_Degree_Progress
Approve_Semester_Plan <-- Advisor

@enduml
